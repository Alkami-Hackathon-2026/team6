@model HACK26.Client.Widget.MyMoneyRules.Models.MoneyRules.RecipeViewModel

<article class="iris-card mrm-card mrm-recipe-card pad--base">
    <span class="mrm-recipe-card__accent @Model.AccentClass" aria-hidden="true"></span>
    <h3 class="font-medium-heading mar-top--none mar-bottom--xsmall">@Model.Title</h3>
    <p class="mrm-step-card__secondary mar-bottom--small">@Model.Description</p>
    <button
        type="button"
        class="iris-button iris-button--secondary width--100"
        data-open-rule-builder
        data-recipe-id="@Model.Id"
        data-builder-name="@Model.BuilderName"
        data-builder-when="@Model.BuilderWhen"
        data-builder-when-detail="@Model.BuilderWhenDetail"
        data-builder-if="@Model.BuilderIf"
        data-builder-if-detail="@Model.BuilderIfDetail"
        data-builder-then="@Model.BuilderThen"
        data-builder-then-detail="@Model.BuilderThenDetail">
        <span class="iris-button__text">Use recipe</span>
    </button>
</article>
