@model HACK26.Client.Widget.MyMoneyRules.Models.MoneyRules.RuleBuilderViewModel

<section class="iris-card mrm-card mrm-natural-builder pad--base" data-natural-language-builder>
    <div class="mrm-kicker">BUILD YOUR OWN BANKING</div>
    <h2 class="mrm-title">What do you want your money to do?</h2>
    <p class="mar-bottom--small">Create simple automations that save, move, organize, and watch your money for you.</p>

    <form data-natural-language-form>
        <div class="mrm-input-row">
            <div class="iris-form-group width--100">
                <label class="iris-form-group__label" for="mrmPromptInput">Describe your rule</label>
                <input
                    id="mrmPromptInput"
                    class="iris-textfield"
                    type="text"
                    name="prompt"
                    placeholder="Every payday, put 10% into my vacation fund"
                    autocomplete="off"
                    data-rule-prompt />
            </div>
            <button type="submit" class="iris-button iris-button--primary">
                <span class="iris-button__text">Build rule</span>
            </button>
        </div>
    </form>

</section>
