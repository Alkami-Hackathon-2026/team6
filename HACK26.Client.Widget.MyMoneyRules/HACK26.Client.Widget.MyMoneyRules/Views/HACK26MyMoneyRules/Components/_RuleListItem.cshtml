@model HACK26.Client.Widget.MyMoneyRules.Models.MoneyRules.MoneyRuleViewModel

<article class="mrm-rule-item iris-account iris-account--multi-line" data-rule-item data-rule-id="@Model.Id" data-rule-state="@(Model.IsActive ? "active" : "paused")">
    <div class="mrm-rule-item__content iris-account__column iris-account__account-details">
        <div class="iris-account__info iris-account__primary-info">
            <p class="mrm-rule-item__name">@Model.Name</p>
        </div>
        <div class="iris-account__info iris-account__secondary-info">
            <span>@Model.TriggerText</span>
            <span class="mrm-rule-arrow" aria-hidden="true">&rarr;</span>
            <span>@Model.ActionText</span>
        </div>
        <p class="mrm-step-card__secondary">Impact: @Model.Impact</p>
    </div>
    <div class="mrm-rule-item__controls">
        <label class="iris-toggle" for="rule-toggle-@Model.Id">
            <input id="rule-toggle-@Model.Id" type="checkbox" data-rule-toggle @(Model.IsActive ? "checked" : null) aria-label="Toggle @Model.Name" />
            <span class="iris-toggle__slider" aria-hidden="true"></span>
        </label>
        <span class="mrm-rule-status" data-rule-status>@(Model.IsActive ? "Active" : "Paused")</span>
    </div>
</article>
