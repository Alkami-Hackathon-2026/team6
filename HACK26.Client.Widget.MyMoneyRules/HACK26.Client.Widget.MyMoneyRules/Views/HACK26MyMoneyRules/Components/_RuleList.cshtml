@model IList<HACK26.Client.Widget.MyMoneyRules.Models.MoneyRules.MoneyRuleViewModel>

<section>
    <div class="mrm-section-head mrm-section-head--rules">
        <h2 class="font-medium-heading">My rules</h2>
        <button type="button" class="iris-button iris-button--primary" data-open-rule-builder>
            <span class="iris-button__text">New rule</span>
        </button>
    </div>

    <div class="iris-card mrm-card mrm-rule-list pad--base">
        @foreach (var rule in Model)
        {
            @Html.Partial("Components/_RuleListItem", rule)
        }
    </div>
</section>
