    "ruleName": "Christmas Savings Large Transfer Notification",
    "ruleDescription": "Send a push notification when transferring more than $500 from Free Checking to Christmas Savings.",
    "status": "ACTIVE",
    "priority": 100,
    "triggerType": "TRANSFER_INITIATED",
    "conditions": [
      {
        "fieldKey": "transfer.fromShareId",
        "comparisonOperator": "EQ",
        "valueType": "STRING",
        "comparisonValue": "shr-3001"
      },
      {
        "fieldKey": "transfer.toShareId",
        "comparisonOperator": "EQ",
        "valueType": "STRING",
        "comparisonValue": "shr-3002"
      },
      {
        "fieldKey": "transfer.amount",
        "comparisonOperator": "GT",
        "valueType": "DECIMAL",
        "comparisonValue": 500
      }
    ],
    "actions": [
      {
        "actionType": "SEND_PUSH_NOTIFICATION",
        "actionConfig": {
          "message": "You have initiated a transfer of more than $500 from your Free Checking to your Christmas Savings account."
        }
      }
    ],
    "sourcePrompt": "When I transfer more than $500 from checking to Christmas Savings, send me a push notification.",
