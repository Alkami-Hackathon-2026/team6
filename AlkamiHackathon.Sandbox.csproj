<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AlkamiHackathon.Sandbox</RootNamespace>
    <UserSecretsId>alkami-hackathon-sandbox-gemini</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Content Update="Data\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.GenAI" Version="1.22.0" />
  </ItemGroup>

</Project>
