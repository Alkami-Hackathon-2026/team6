{
  "actions": [
    {
      "actionId": "act-push-2938",
      "ruleVersionId": "rulever-2938-003",
      "actionType": "SEND_PUSH_NOTIFICATION",
      "actionConfig": {
        "templateId": "large-transaction-alert",
        "parameters": {
          "amount": "${transaction.amount}",
          "merchant": "${merchant.normalizedName}",
          "availableBalance": "${account.availableBalance}"
        },
        "deduplicationWindowSeconds": 300
      },
      "sequenceNumber": 1,
      "executionMode": "ASYNCHRONOUS",
      "failureBehavior": "RETRY",
      "maximumAttempts": 3,
      "isEnabled": true
    },
    {
      "actionId": "act-tag-2938",
      "ruleVersionId": "rulever-2938-003",
      "actionType": "ADD_TRANSACTION_TAG",
      "actionConfig": {
        "tag": "REVIEW"
      },
      "sequenceNumber": 2,
      "executionMode": "ASYNCHRONOUS",
      "failureBehavior": "CONTINUE",
      "maximumAttempts": 3,
      "isEnabled": true
    }
  ]
}
