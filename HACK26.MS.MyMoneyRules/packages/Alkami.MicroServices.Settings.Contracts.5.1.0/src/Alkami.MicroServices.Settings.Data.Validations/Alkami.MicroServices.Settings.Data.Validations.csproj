<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net472;net6.0</TargetFrameworks>
    <Description>This is the set of Contracts and Entity definitions for the Settings Micro Service</Description>
    <PackageTags>micro microservice settings</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>Alkami.MicroServices.Settings.Data.Validations.$(MediumNameSuffix)</AssemblyName>
    <RootNamespace>Alkami.MicroServices.Settings.Data.Validations</RootNamespace>
    <PackageId>Alkami.MicroServices.Settings.Contracts</PackageId>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <VersionPrefix>$(MediumNameVersionPrefix)</VersionPrefix>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeP2PAssets</TargetsForTfmSpecificBuildOutput>
    <Configurations>Debug;Release;k8s</Configurations>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Alkami.GlobalAssets" Version="2.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Alkami.LibraryAssets" Version="1.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Alkami.MicroServices.Core" Version="4.3.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Alkami.MicroServices.Settings.Contracts\Alkami.MicroServices.Settings.Contracts.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Alkami.MicroServices.Settings.Data\Alkami.MicroServices.Settings.Data.csproj" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>$(ProjectName).Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Alkami.MicroServices.Settings.IntegrationTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <Target Name="IncludeP2PAssets" DependsOnTargets="BuildOnlySettings;ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths-&gt;WithMetadataValue('ReferenceSourceTarget', 'ProjectReference')-&gt;WithMetadataValue('PrivateAssets', 'all'))" />
    </ItemGroup>
  </Target>
</Project>