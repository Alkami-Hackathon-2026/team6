<?xml version="1.0"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
	<appSettings xdt:Transform="InsertIfMissing">
		<add key="NewRelic.AppName" value="Alkami.MicroServices.REPLACEME" xdt:Transform="InsertIfMissing" xdt:Locator="Match(key)" />
		<add key="NewRelic.AgentEnabled" value="true" xdt:Transform="InsertIfMissing" xdt:Locator="Match(key)" />
	</appSettings>
</configuration>