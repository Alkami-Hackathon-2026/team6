<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net462;net6.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);CustomContentTarget</TargetsForTfmSpecificContentInPackage>
    <LangVersion Condition="'$(TargetFramework)' == 'net462'">8.0</LangVersion>
  </PropertyGroup>
  <PropertyGroup>
    <PackageProjectUrl>https://extranet.alkamitech.com/display/ORB/Alkami.Monitoring.NewRelic</PackageProjectUrl>
    <PackageTags>Monitoring NewRelic</PackageTags>
    <Description>Includes the logic necessary to use NewRelic to monitor.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Alkami.Monitoring\Alkami.Monitoring.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Alkami.GlobalAssets" Version="2.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Alkami.LibraryAssets" Version="1.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Alkami.Utilities.Configuration" Version="2.0.0" />
    <PackageReference Include="NewRelic.Agent.Api" Version="9.4.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net6.0'">
    <PackageReference Include="Alkami.Utilities.Kubernetes" Version="1.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="6.0.3" />
  </ItemGroup>
  <Target Name="CustomContentTarget" BeforeTargets="DispatchToInnerBuilds">
    <ItemGroup>
      <None Include="../Content/Alkami.Monitoring.NewRelic/app.config.install.xdt" PackagePath="content" Pack="true" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <InternalsVisibleTo Include="Alkami.Monitoring.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>
</Project>