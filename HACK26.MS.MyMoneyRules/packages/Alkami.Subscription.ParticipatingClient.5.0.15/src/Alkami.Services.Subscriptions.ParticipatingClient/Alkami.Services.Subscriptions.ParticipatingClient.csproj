<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net472;net6.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
  <PropertyGroup>
    <PackageId>Alkami.Subscription.ParticipatingClient</PackageId>
    <Description>Includes the participating Client assemblies for the subscription services</Description>
    <Title>Alkami Services Subscriptions Participating Client</Title>
    <PackageTags>SubscriptionService ParticipatingClient</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Alkami.GlobalAssets" Version="2.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Alkami.LibraryAssets" Version="1.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Alkami.Broker" Version="2.15.1" />
    <PackageReference Include="Alkami.Utilities.Kubernetes" Version="1.1.0" />
    <PackageReference Include="Alkami.Utilities.Rpc" Version="4.0.1" />
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
  </ItemGroup>
  <ItemGroup Condition=" '$(TargetFramework)' == 'net472' ">
    <Reference Include="System.IdentityModel" />
    <Reference Include="System.ServiceModel" />
  </ItemGroup>
  <ItemGroup Condition=" '$(TargetFramework)' == 'net6.0' ">
    <PackageReference Include="System.Reactive.Linq" Version="5.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Alkami.Services.Subscriptions.Data\Alkami.Services.Subscriptions.Data.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Alkami.Services.Subscriptions.Resolver\Alkami.Services.Subscriptions.Resolver.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="SelfResolvingClient.*.cs">
      <DependentUpon>SelfResolvingClient.cs</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>$(ProjectName).Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Alkami.MicroServices.Subscriptions.ProviderBased</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Alkami.Services.Subscriptions.ParticipatingService.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Alkami.Services.Subscriptions.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Alkami.Services.Subscriptions.TestMocks</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>DynamicProxyGenAssembly2</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Alkami.MicroServices.Test.Service.Client</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>