<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net472;net6.0;net8.0</TargetFrameworks>
    <Description>Proxy Class for the UserContacts microservice</Description>
    <PackageTags>UserContacts Contacts</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AssemblyName>Alkami.MS.UserContacts.Service.Client.$(MediumNameSuffix)</AssemblyName>
    <RootNamespace>Alkami.MS.UserContacts.Service.Client</RootNamespace>
    <PackageId>Alkami.MS.UserContacts.Client</PackageId>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <VersionPrefix>$(MediumNameVersionPrefix)</VersionPrefix>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Alkami.GlobalAssets" Version="2.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Alkami.LibraryAssets" Version="1.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Alkami.Monitoring.NewRelic" Version="2.11.0" />
    <PackageReference Include="Alkami.Subscription.ParticipatingClient" Version="5.4.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Alkami.MS.UserContacts.Contracts\Alkami.MS.UserContacts.Contracts.csproj" />
    <ProjectReference Include="..\Alkami.MS.UserContacts.Data\Alkami.MS.UserContacts.Data.csproj">
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>$(ProjectName).Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>