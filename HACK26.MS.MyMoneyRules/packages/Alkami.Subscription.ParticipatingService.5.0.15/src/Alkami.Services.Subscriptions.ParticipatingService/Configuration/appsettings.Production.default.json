{
  "LogConfiguration": {
    "factoryAdapter": {
      "type": "Common.Logging.Serilog.SerilogFactoryAdapter, Common.Logging.Serilog"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Error",
      "Override": {
        "Alkami.Extensions.RequestLogging": "Fatal",
        "CoreWCF": "Error"
      }
    },
    "Using": [ "Serilog.Sinks.File", "Alkami.Extensions.Logging" ],
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "formatter": "Alkami.Extensions.Logging.AlkamiCompactJsonFormatter, Alkami.Extensions.Logging",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 10,
          "fileSizeLimitBytes": 20971520,
          "rollOnFileSizeLimit": true
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId", "WithSpan" ]
  }
}
