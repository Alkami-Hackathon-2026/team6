{
  "LogConfiguration": {
    "factoryAdapter": {
      "type": "Common.Logging.Serilog.SerilogFactoryAdapter, Common.Logging.Serilog"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Alkami.Extensions.RequestLogging": "Fatal",
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "CoreWCF": "Error"
      }
    },
    "Using": [ "Serilog.Sinks.File", "Alkami.Extensions.Logging", "Serilog.Sinks.Console" ],
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "formatter": "Alkami.Extensions.Logging.AlkamiCompactJsonFormatter, Alkami.Extensions.Logging",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 10,
          "fileSizeLimitBytes": 20971520,
          "rollOnFileSizeLimit": true
        }
      },
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:o} |*| {ThreadId} |*| {Level} |*| {SourceContext} |*| {CorrelationID} |*| {BankIdentifier} |*| {UserIdentifier} |*| {Message}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId", "WithSpan" ]
  }
}
