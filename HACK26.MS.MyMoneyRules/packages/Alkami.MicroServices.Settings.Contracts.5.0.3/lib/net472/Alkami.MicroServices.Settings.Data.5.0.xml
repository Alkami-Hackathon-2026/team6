            <summary>
            Bank Record
            </summary>
        </member>
        <member name="P:Alkami.MicroServices.Settings.Data.Bank.AdminUrlSignature">
            <summary>
            The host name and top-level domain for admin that requests for this institution are directed to.
            </summary>
            <remarks>
            An example of this value is 'www.example.com' or 'www.example.com/login?bankid=1'
            </remarks>
        </member>
        <member name="P:Alkami.MicroServices.Settings.Data.Bank.BankIdentifier">
            <summary>
            A globally-unique identifier that represents a financial institution.
            </summary>
            <remarks>
            The BankIdenitifer is the ID by which any other component of the system, including
            third party components and the claims on secure tokens references a financial institution.  The internal
            ID is not exposed to alleviate replication issues and to reduce third-party component dependence
            on internal ID fields for this common data entity, as well as multi-tenancy considerations.
            </remarks>
        </member>
        <member name="P:Alkami.MicroServices.Settings.Data.Bank.CreateDate">
            <summary>
            Date/Time the Bank was created
            </summary>
        </member>
        <member name="P:Alkami.MicroServices.Settings.Data.Bank.Id">
            <summary>
            Primary id of the Bank
            </summary>
        </member>
        <member name="P:Alkami.MicroServices.Settings.Data.Bank.IdleLogoutMinutes">
            <summary>
            The maximum number of minutes a user of the financial institution can be idle
            in a presentation layer interface before their session is automatically ended.
            </summary>
        </member>
        <member name="P:Alkami.MicroServices.Settings.Data.Bank.IdleLogoutURL">
            <summary>
            The URL to which users are redirected if they are forcibly logged out of their session due to idle session limits
            </summary>
            <remarks>
            While this may be overriden at the flavor level, this is the default for newly-created flavors.
            </remarks>
        </member>
        <member name="P:Alkami.MicroServices.Settings.Data.Bank.LocaleID">
            <summary>
            The LocaleID that should be configured for a user if they are assigned to this flavor
            during the on-boarding process.
            </summary>
            <remarks>
            While this may be overriden at the flavor level, this is the default for newly-created flavors.
            </remarks>
        </member>
        <member name="P:Alkami.MicroServices.Settings.Data.Bank.LogoImage">
             <summary>
             The image shown in the "logo" portion of the user interface
             </summary>
             <remarks>
             If null, the parent's logo (or the parent's parent, recusively) should be shown.
            
             While this may be overriden at the flavor level, this is the default for newly-created flavors.
             </remarks>
        </member>
        <member name="P:Alkami.MicroServices.Settings.Data.Bank.MobileLogoImage">
            <summary>
            The image shown in the "logo" portion of the user interface in mobile
            </summary>
            <remarks>
            While this may be overriden at the flavor level, this is the default for newly-created flavors.
            </remarks>
        </member>
        <member name="P:Alkami.MicroServices.Settings.Data.Bank.Name">
            <summary>
            The name of the financial institution.
            </summary>
        </member>
        <member name="P:Alkami.MicroServices.Settings.Data.Bank.TimeZoneInfo">
            <summary>
            A serialized string which represents how to treat dates received from and transmitted to the
            user so they are represented in their local timezone or timezone of choice.
            </summary>
            <remarks>
            All users that are 'onboarded' for this bank are given this as their default time zone.
            </remarks>
        </member>
        <member name="P:Alkami.MicroServices.Settings.Data.Bank.UrlSignature">
